# Normalize line endings: LF in the repo, native on checkout where sensible.
# Stops the perpetual CRLF "modified" churn between Windows, WSL, and CI.
* text=auto

*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.kql text eol=lf
*.md text eol=lf
*.bicep text eol=lf
.platform text eol=lf

*.whl binary
*.pdf binary
